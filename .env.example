VITE_APP_TITLE=HEI
# 开发默认 VITE_API_URL 留空，走同源 /api + Vite proxy（Cookie 会话）。
# 指向独立 Portal 后端（hei-boot-portal:8001 / hei-fastapi-portal:8101 / hei-gin-portal:8201）
# 勿再指向已退役的双端单体。
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
VITE_PORT=5174
VITE_HOME_PATH=/
# 页脚可选：版权、备案号、联系方式
# VITE_COPYRIGHT_INFO=© 2026 HEI
# VITE_ICP_FILING=京ICP备xxxxxxxx号
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_SUPPORT_PHONE=400-000-0000
